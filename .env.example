# ──────────────────────────────────────────────────────────────────────────────
#  ڤيب شوب | Vape Shop — environment
#  Copy to `.env` and fill in. Never commit the real `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#  • Local development without Docker:  npm run db:dev   (Prisma local Postgres)
#  • Managed Postgres (Neon / Supabase / RDS):
#      postgresql://USER:PASSWORD@HOST:5432/vapeshop?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vapeshop?schema=public"

# 32+ byte random secret used to derive session-token hashes and sign cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-value-at-least-32-characters"

# Public origin of the app (used for absolute links in receipts and emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session lifetime in days.
SESSION_DAYS="30"

# Set to "1" to allow public self-service store registration.
ALLOW_PUBLIC_SIGNUP="1"

# Support contact shown on the help and subscription pages.
# The phone link is only rendered when SUPPORT_PHONE is set.
SUPPORT_EMAIL="support@vapeshop.app"
SUPPORT_PHONE=""

# Credentials created by `npm run db:seed` for the demo tenant.
SEED_OWNER_EMAIL="owner@vapeshop.demo"
SEED_OWNER_PASSWORD="Owner@12345"
SEED_ADMIN_EMAIL="admin@vapeshop.app"
SEED_ADMIN_PASSWORD="Admin@12345"
